# Local / Compose defaults — copy to .env and adjust
DEMO_API_KEY=demo-key-change-me
PROVIDER_MODE=mock
REDIS_URL=redis://redis:6379/0
ROUTER_URL=http://router:8081
GATEWAY_PORT=8080
ROUTER_PORT=8081
# Host-published ports (Compose). Defaults avoid clashing with other local stacks.
GATEWAY_HOST_PORT=18080
ROUTER_HOST_PORT=18081
LOG_LEVEL=info

# Routing (Step 2) — used when PROVIDER_MODE=multi (and as defaults for single-provider modes)
ROUTING_POLICY=failover
# prefer_cost | prefer_latency | prefer_provider | failover
ROUTING_PRIMARY=bedrock
ROUTING_FALLBACK=vertex,mock
PROVIDER_TIMEOUT_MS=5000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_MS=30000
MOCK_LATENCY_MS=40

# Cost / latency hints for prefer_cost / prefer_latency (USD per 1K tokens / ms)
PROVIDER_COST_PER_1K_INPUT=mock:0.0,bedrock:0.00025,vertex:0.000075
PROVIDER_COST_PER_1K_OUTPUT=mock:0.0,bedrock:0.00125,vertex:0.0003
PROVIDER_LATENCY_MS=mock:40,bedrock:200,vertex:150

# Logical model → provider:physical_model (semicolon-separated entries)
MODEL_MAP=gpt-proxy=bedrock:anthropic.claude-3-haiku-20240307-v1:0,vertex:gemini-1.5-flash;mock-small=mock:mock-small

# Optional — only when PROVIDER_MODE is bedrock / vertex / multi
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
