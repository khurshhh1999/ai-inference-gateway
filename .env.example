# Local / Compose defaults — copy to .env and adjust
DEMO_API_KEY=demo-key-change-me
PROVIDER_MODE=mock
REDIS_URL=redis://redis:6379/0
# Compose Redis image (Redis 8 includes Query Engine for HNSW cache lookup)
# REDIS_IMAGE=redis:8-alpine
# REDIS_IMAGE=redis:7-alpine   # forces scan fallback
ROUTER_URL=http://router:8081
GATEWAY_PORT=8080
ROUTER_PORT=8081
# Host-published ports (Compose). Defaults avoid clashing with other local stacks.
GATEWAY_HOST_PORT=18080
ROUTER_HOST_PORT=18081
LOG_LEVEL=info

# Gateway hardening
MAX_BODY_BYTES=262144

# Gateway rate limiting (token bucket in Redis; concurrency/QPS — not USD budgets)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
# RATE_LIMIT_REDIS_URL=  # optional override; defaults to REDIS_URL
RATE_LIMIT_KEY_QPS=10
RATE_LIMIT_KEY_BURST=20
# Optional per-tenant ceiling across all keys for that tenant (0 / empty = off)
# RATE_LIMIT_TENANT_QPS=50
# RATE_LIMIT_TENANT_BURST=100

# Observability host ports (docker compose --profile monitoring)
PROMETHEUS_HOST_PORT=19090
GRAFANA_HOST_PORT=13000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_UI_HOST_PORT=16686

# OpenTelemetry — spans always created when OTEL_ENABLED=true; OTLP export optional
OTEL_ENABLED=true
OTEL_SERVICE_NAME_GATEWAY=gateway
OTEL_SERVICE_NAME_ROUTER=router
OTEL_CONSOLE_EXPORTER=false
# With --profile monitoring, export to Jaeger:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Routing — used when PROVIDER_MODE=multi (and as defaults for single-provider modes)
ROUTING_POLICY=failover
# prefer_cost | prefer_latency | prefer_provider | failover | adaptive
ROUTING_PRIMARY=bedrock
ROUTING_FALLBACK=vertex,mock
PROVIDER_TIMEOUT_MS=5000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_MS=30000
MOCK_LATENCY_MS=40

# Cost / latency hints for prefer_cost / prefer_latency / adaptive cold start
PROVIDER_COST_PER_1K_INPUT=mock:0.0,bedrock:0.00025,vertex:0.000075
PROVIDER_COST_PER_1K_OUTPUT=mock:0.0,bedrock:0.00125,vertex:0.0003
PROVIDER_LATENCY_MS=mock:40,bedrock:200,vertex:150

# Adaptive routing (ROUTING_POLICY=adaptive). Live EWMA; hints above are the prior.
ADAPTIVE_EWMA_ALPHA=0.3
ADAPTIVE_ERROR_PENALTY_MS=1000
ADAPTIVE_MIN_SAMPLES=1
ADAPTIVE_STALE_AFTER_SECONDS=30

# Logical model → provider:physical_model (semicolon-separated entries)
MODEL_MAP=gpt-proxy=bedrock:anthropic.claude-3-haiku-20240307-v1:0,vertex:gemini-1.5-flash;mock-small=mock:mock-small

# Semantic cache
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.90
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=1000
CACHE_EMBEDDING_PROVIDER=hashing
# hashing (default, no ML deps) | sentence-transformers (optional extra)
CACHE_EMBEDDING_DIM=256
# scan (O(n) JSON scan, any Redis) | redisearch (HNSW KNN) | auto (use search module if present)
CACHE_INDEX_BACKEND=auto
CACHE_ANN_TOP_K=25
CACHE_ANN_EF_RUNTIME=64
# Mock list prices are $0; this stand-in USD is credited on cache hits for demos
CACHE_MOCK_SAVINGS_USD=0.002

# Tenant API keys — gateway maps key → tenant id for billing / cache
# Format: key:tenant,other-key:acme  (or JSON object). If unset, DEMO_API_KEY → "default".
# TENANT_API_KEYS=demo-key-change-me:default,acme-key:acme

# Per-tenant budgeting — Redis counters for USD + tokens (minute/day/month)
BUDGET_ENABLED=true
BUDGET_SOFT_RATIO=0.8
BUDGET_HARD_STATUS=402
# Stand-in USD/request for mock when provider list price is $0
BUDGET_MOCK_USD=0.002
BUDGET_USD_PER_DAY=10
BUDGET_USD_PER_MONTH=100
BUDGET_TOKENS_PER_DAY=1000000
BUDGET_TOKENS_PER_MONTH=10000000
# Optional minute windows (unset = unlimited)
# BUDGET_USD_PER_MINUTE=1
# BUDGET_TOKENS_PER_MINUTE=100000
# Per-tenant overrides: acme:usd_day:1.0,tokens_day:5000;beta:usd_month:50
# TENANT_BUDGETS=
# Optional per-model pricing overrides (else provider rates above)
# MODEL_COST_PER_1K_INPUT=mock-small:0.002
# MODEL_COST_PER_1K_OUTPUT=mock-small:0.004

# Optional — only when PROVIDER_MODE is bedrock / vertex / multi
# Live Bedrock dry-run (Compose overlay; see deploy/aws/LIVE.md):
#   docker compose -f docker-compose.yml -f docker-compose.bedrock.yml up --build
# Or without the overlay file:
#   ROUTER_INSTALL_EXTRAS='[bedrock]' PROVIDER_MODE=bedrock ...
# ROUTER_INSTALL_EXTRAS=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Prefer AWS_PROFILE / SSO / ECS task role over long-lived keys.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# For Compose + Vertex: mount the SA JSON into the router container and point at it.
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp.json
